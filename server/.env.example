# Server Environment Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=system
DB_PASSWORD=system
DB_NAME=golf_charity
DB_LOGGING=false

# Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_32_characters_minimum_development
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_32_characters_minimum_development
JWT_REFRESH_EXPIRES_IN=30d

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard/subscriptions?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/plans

# Application Business Parameters
DEFAULT_CURRENCY=USD
MIN_CHARITY_PERCENTAGE=10.00
MAX_ACTIVE_GOLF_SCORES=5
